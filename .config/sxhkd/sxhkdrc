super + shift + w
    chromium
    #firefox

super + v
    st -e vim

super + Return
    st

super + d
    dolphin

super + r
    st -e rmpc

super + o
    rofi -show drun

ctrl + shift + Print
    maim -s | xclip -selection clipboard -t image/png

super + f
    setbg $HOME/Downloads/wallpapers

# toggle song state for rmpc
super + t
    mpc toggle

super + shift + p
    nsxiv $HOME/uni/resources/schedule.jpeg

super + y
    st -e bash -ic y # y: alias for yazi (see ~/.bashrc)

super + shift + y
    st -e bash -ic y ~/uni/S1 


super + shift + s
    st -e ctimer create

super + s
    st -e ctimer toggle


##  Scripts (in $HOME/.local/bin)

super + p
    mpv "$(xclip -o -selection clipboard)"

super + m
    mount.sh

super + {equal,minus,BackSpace}
    volume.sh {up,down,toggle}

XF86Audio{RaiseVolume,LowerVolume,Mute}
    volume.sh {up,down,toggle}

super + q
    exit.sh

